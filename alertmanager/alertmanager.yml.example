global:
  resolve_timeout: 5m
  smtp_smarthost: 'smtp.gmail.com:587'
  smtp_from: 'SEU_EMAIL@gmail.com'
  smtp_auth_username: 'SEU_EMAIL@gmail.com'
  smtp_auth_password: 'SUA_SENHA_DE_APP_AQUI'
  smtp_require_tls: true
route:
  receiver: 'email-e-webhook'
  group_by: ['alertname', 'instance']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 3h
receivers:
  - name: 'email-e-webhook'
    email_configs:
      - to: 'SEU_EMAIL_DESTINO@gmail.com'
        send_resolved: true
    webhook_configs:
      - url: 'http://webhook-receiver:5001/webhook'
        send_resolved: true

inhibit_rules:
  - source_match:
      severity: 'critical'
    target_match:
      severity: 'warning'
    equal: ['alertname', 'instance']
